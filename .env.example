# Backend FastAPI — copia este archivo como .env para desarrollo local.
# En Vercel (proyecto `nuby-web`) estas variables se configuran en Settings → Environment Variables.
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-this-secret-key-in-production
# Local: SQLite. Producción: la cadena "pooled" de Neon (postgres://... también es válida).
DATABASE_URL=sqlite:///./nuby.db
# Opcional: conexión directa de Neon (sin pooler), usada solo por las migraciones.
DATABASE_URL_UNPOOLED=
CORS_ORIGINS=https://nubypsicologa.com,https://www.nubypsicologa.com,http://localhost:3000,http://127.0.0.1:3000
# Opcional: permite los Preview del frontend en Vercel.
CORS_ORIGIN_REGEX=
ACCESS_TOKEN_EXPIRE_MINUTES=720
UPLOAD_DIR=uploads
STORAGE_BACKEND=local
BLOB_UPLOAD_PREFIX=uploads
MAX_UPLOAD_SIZE_MB=5
BLOB_READ_WRITE_TOKEN=
